{
  "name": "inkforge-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @inkforge/db prisma:generate",
    "db:migrate": "pnpm --filter @inkforge/db prisma:migrate",
    "db:seed": "pnpm --filter @inkforge/db seed"
  },
  "devDependencies": {
    "turbo": "^2.0.6",
    "typescript": "^5.6.2"
  }
}
